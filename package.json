{
  "name": "gothic-2-pre-alpha",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "start": "node .output/server/index.mjs",
    "dev": "nuxt dev",
    "prod": "yarn build && yarn start",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "static:preview": "npx serve .output/public",
    "static:build": "yarn generate && yarn static:preview",
    "postinstall": "nuxt prepare",
    "lint": "yarn lint:eslint && yarn lint:prettier",
    "lint:eslint": "eslint .",
    "lint:prettier": "prettier . --check",
    "lintfix": "eslint . --fix && prettier --write --list-different ."
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.90",
    "@iconify-json/simple-icons": "^1.2.70",
    "@nuxt/ui": "^4.4.0",
    "@nuxtjs/mdc": "0.20.1",
    "nuxt": "^4.3.1",
    "remark-github": "^12.0.0",
    "scule": "^1.3.0",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.15.1",
    "eslint": "^10.0.0",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "vue-tsc": "^3.2.4"
  },
  "packageManager": "yarn@4.12.0"
}
